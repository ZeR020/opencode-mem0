{
  "name": "opencode-mem0",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "opencode web",
