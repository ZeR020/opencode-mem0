#!/bin/sh
# Pre-commit: block secrets, then typecheck + format staged files.
# File-type/dir blocking is handled by .gitignore — don't duplicate it here.
# Bypass: git commit --no-verify

set -e

# Block common secret/API-key patterns in staged text files
STAGED=$(git diff --cached --name-only --diff-filter=ACM || true)
for file in $STAGED; do
  if [ -f "$file" ] && git diff --cached -- "$file" 2>/dev/null | grep -qiE 'sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}|github_pat_[a-zA-Z0-9]{20,}|hf_[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|glpat-[a-zA-Z0-9\-]{20,}|dapi[a-f0-9]{32}|pypi-[a-zA-Z0-9]{20,}|npm_[a-zA-Z0-9]{20,}|ya29\.[0-9A-Za-z\-_]+'; then
    echo "❌ Potential secret in $file — remove it, or commit --no-verify if it's a test value."
    exit 1
  fi
done

bun run typecheck && bunx lint-staged
